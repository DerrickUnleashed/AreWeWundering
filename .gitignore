venv/
__pycache__/

# datasets/valid_mask.parquet IS tracked with git-lfs (92 MB, under the 2 GiB
# per-LFS-object limit).  train.parquet (29.2 GB) and valid.parquet (5.6 GB)
# cannot be: GitHub rejects any single LFS object over 2 GiB, and the 33 GB
# total would exceed the free 10 GiB storage tier anyway.  Both are organiser
# files that arrive with the starter pack and are byte-identical to it; their
# sha256 sums and the cache-regeneration command are in
# datasets/MANIFEST.md.  Do not re-add these two lines.
datasets/train.parquet
datasets/valid.parquet

# Regenerable memmap shard cache (built by tools/make_shards.py).
cache/

# exploration/checkpoints/, exploration/logs/ and submissions/ are deliberately
# TRACKED (2026-09-29): the run logs, the checkpoints and the submission bundles
# are the record of what was actually trained and shipped, and they are small
# enough (single-digit MB per version) to keep in git.  Only the regenerable
# shard cache and the organiser's oversized parquets stay out.

.DS_Store
